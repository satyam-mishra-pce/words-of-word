{
  "name": "words-of-word",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm build && NODE_OPTIONS=--conditions=development turbo dev --parallel",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test:game-engine:index": "pnpm lexicon:ensure && pnpm --filter @wow/game-engine build && pnpm --filter @wow/lexicon build && node scripts/verify-game-engine-index.mjs",
    "lexicon:build": "pnpm --filter @wow/lexicon artifact:build",
    "lexicon:ensure": "test -f packages/lexicon/artifacts/words-of-word-lexicon-v0.2.0.sqlite || pnpm lexicon:fetch",
    "lexicon:validate": "pnpm --filter @wow/lexicon artifact:validate --artifact=artifacts/words-of-word-lexicon-v0.2.0.sqlite",
    "lexicon:fetch": "pnpm --filter @wow/lexicon artifact:fetch",
    "lexicon:pin-release": "pnpm --filter @wow/lexicon artifact:pin-manifest --authorize=release-authoring",
    "test:lexicon": "pnpm --filter @wow/lexicon test",
    "test:render-free:cell": "pnpm lexicon:ensure && pnpm --filter @wow/lexicon build && node scripts/run-render-free-cell.mjs",
    "test:render-free:sweep": "pnpm lexicon:ensure && pnpm --filter @wow/lexicon build && node scripts/sweep-render-free-capacity.mjs",
    "test:production:capacity": "pnpm lexicon:ensure && pnpm --filter @wow/lexicon build && node apps/web/scripts/production-capacity-cell.mjs",
    "mobile:sync": "pnpm --filter @wow/web cap:sync",
    "mobile:ios": "pnpm --filter @wow/web cap:ios",
    "mobile:android": "pnpm --filter @wow/web cap:android"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.8.3"
  }
}
