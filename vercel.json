{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @wow/shared build && pnpm --filter @wow/web build",
  "outputDirectory": "apps/web/dist",
  "env": {
    "VITE_PUBLIC_WEB_URL": "https://portfolio.wordsofword.in",
    "VITE_GAME_URL": "https://wordsofword.in/",
    "VITE_SOCKET_URL": "https://words-of-word.onrender.com"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
