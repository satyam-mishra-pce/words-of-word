# Words of Word — game server env template. Copy to `.env` for local dev.
# All optional: without these the server runs fully (anonymous play + analytics);
# streak/ELO/leaderboard writes simply become no-ops.

# Supabase — server-authoritative competitive stats (streak, ELO, leaderboards).
# The service role key BYPASSES RLS and must NEVER reach a client. Keep it only
# on the server (GitHub Secret / Render dashboard / this local .env).
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-sb_secret-KEY

# Optional durable analytics (Postgres) + admin dashboard password.
# ANALYTICS_DATABASE_URL=
# ANALYTICS_TOKEN=
