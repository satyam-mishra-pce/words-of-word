# Words of Word — web env template. Copy to `.env.local` for local dev.
# All of these are OPTIONAL: without them the game runs fully anonymously and
# the Google sign-in UI simply hides itself.

# Supabase project (Project Settings -> API). The anon key is a public,
# RLS-protected client key and is safe to embed in the built frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Optional: point the web app at a specific game server during local dev.
# VITE_GAME_SERVER_URL=http://localhost:4000
