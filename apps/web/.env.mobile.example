# Public HTTPS Socket.IO/Fastify origin. Capacitor release builds must not point at capacitor://localhost.
VITE_GAME_SERVER_URL=https://words-of-word.example.com

# Canonical HTTPS website used in room invitations, Universal Links, and Android App Links.
VITE_PUBLIC_WEB_URL=https://words-of-word.example.com

# Optional Supabase Google sign-in. Without these the native app plays anonymously
# and the sign-in UI hides itself. The anon key is a public, RLS-protected client key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
