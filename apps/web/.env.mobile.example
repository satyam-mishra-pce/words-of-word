# Public HTTPS Socket.IO/Fastify server. Capacitor release builds must not point at capacitor://localhost.
VITE_SOCKET_URL=https://words-of-word.example.com

# Canonical HTTPS website used in room invitations, Universal Links, and Android App Links.
VITE_PUBLIC_WEB_URL=https://words-of-word.example.com

# Optional Hotjar site ID. This is public build-time configuration, not a secret.
# Hotjar stays off when no site ID is supplied.
VITE_HOTJAR_SITE_ID=
VITE_HOTJAR_VERSION=6
VITE_HOTJAR_ENABLED=true

# The web SDK is disabled in Capacitor shells unless explicitly approved.
VITE_HOTJAR_ENABLE_NATIVE=false
