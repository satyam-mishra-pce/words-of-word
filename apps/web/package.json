{
  "name": "@wow/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "node scripts/check-game-parity.mjs && tsc -p tsconfig.json && vite build && node scripts/prerender-seo.mjs",
    "parity": "node scripts/check-game-parity.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "pnpm typecheck",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "cap:build": "node scripts/assert-mobile-env.mjs && tsc -p tsconfig.json && vite build --mode mobile",
    "cap:sync": "pnpm run cap:build && cap sync",
    "cap:copy": "cap copy",
    "cap:ios": "pnpm run cap:sync && cap open ios",
    "cap:android": "pnpm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capawesome/capacitor-navigation-bar": "^8.0.1",
    "@vitejs/plugin-react": "^4.5.2",
    "@wow/shared": "workspace:*",
    "framer-motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "socket.io-client": "^4.8.1",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.8.3"
  }
}
